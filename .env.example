# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEON POSTGRESQL DATABASE URL:
# Obtain this from your Neon console (e.g. postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.neon.tech/neondb?sslmode=require"

# ADMIN AUTHENTICATION:
# Password for /admin login (default: qaynar2026)
ADMIN_PASSWORD="qaynar2026"
SESSION_SECRET="qaynar-secret-seminar-2026-key"
